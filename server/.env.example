# SOLTR backend local configuration
NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# Database
MONGO_URI=mongodb://127.0.0.1:27017/soltr

# Frontend/API origins
CLIENT_ORIGIN=http://localhost:5500
FRONTEND_URL=http://localhost:5500

# JWT signing secrets — replace with long random values; never commit real values
JWT_SECRET=replace-with-a-long-random-admin-secret
CUSTOMER_JWT_SECRET=replace-with-a-long-random-customer-secret

# Resend email service
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SOLTR Wear <onboarding@resend.dev>

# First-admin bootstrap; password must be at least 12 characters
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-12-plus-character-password
ADMIN_BOOTSTRAP_NAME=SOLTR Administrator
